---
import Layout from '../layouts/Layout.astro';
import AttendancePortal from '../components/AttendancePortal';
import { getSupabaseServer, getUserProfile } from '../lib/auth';

const client = getSupabaseServer(Astro.cookies);
const profile = await getUserProfile(client);

if (!profile) {
  return Astro.redirect('/login');
}

if (profile.role === 'admin') {
  return Astro.redirect('/admin');
}

// Get pagination parameters from URL
const urlPage = Astro.url.searchParams.get('page');
const currentPage = urlPage ? parseInt(urlPage) : 1;
const pageSize = 5; // Display 5 items per page

// Fetch user attendance history
const { data: history } = await client
  .from('attendances')
  .select(`
    id,
    session_id,
    status,
    reason,
    proof_url,
    approval_status,
    created_at,
    sessions (
      id,
      date
    )
  `)
  .eq('user_id', profile.id)
  .order('created_at', { ascending: false });

// Fetch active session
const { data: activeSessions } = await client
  .from('sessions')
  .select('*')
  .eq('is_active', true)
  .order('created_at', { ascending: false })
  .limit(1);

const activeSession = activeSessions && activeSessions.length > 0 ? activeSessions[0] : null;

// Find if user has already checked in or submitted excuse for today's active session
const todayAttendance = activeSession && history
  ? history.find((att: any) => att.session_id === activeSession.id)
  : null;

// Pagination calculations
const totalItems = history ? history.length : 0;
const totalPages = Math.ceil(totalItems / pageSize) || 1;
const page = Math.max(1, Math.min(currentPage, totalPages)); // Bind page to valid range

const paginatedHistory = history 
  ? history.slice((page - 1) * pageSize, page * pageSize)
  : [];

const getStatusBadgeClass = (status: string) => {
  switch (status) {
    case 'hadir': return 'bg-emerald-50 text-emerald-700 border-emerald-200';
    case 'sakit': return 'bg-rose-50 text-rose-700 border-rose-200';
    case 'izin': return 'bg-yellow-50 text-amber-700 border-yellow-200';
    default: return 'bg-slate-50 text-slate-700 border-slate-200';
  }
};

const getApprovalBadgeClass = (status: string) => {
  switch (status) {
    case 'approved': return 'bg-emerald-100 text-emerald-800';
    case 'pending': return 'bg-amber-100 text-amber-800 animate-pulse';
    case 'rejected': return 'bg-rose-100 text-rose-800';
    default: return 'bg-slate-100 text-slate-800';
  }
};

const formatIndonesianDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('id-ID', {
    weekday: 'long',
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};
---

<Layout title="Dashboard Anggota" role={profile.role} userName={profile.full_name} division={profile.division}>
  <div class="space-y-6">
    <!-- Welcome Header Card -->
    <div class="bg-gradient-to-tr from-emerald-950 to-emerald-800 text-white rounded-3xl p-6 shadow-md relative overflow-hidden border border-emerald-500/20">
      <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-emerald-500/10 rounded-full blur-xl"></div>
      <div class="relative z-10 space-y-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-200">Selamat Datang,</p>
        <h2 class="text-xl font-extrabold tracking-tight">{profile.full_name}</h2>
        <div class="pt-2 border-t border-white/10 flex justify-between items-center text-xs">
          <p class="font-medium text-emerald-100">NIM: <span class="font-bold text-emerald-300">{profile.nim}</span></p>
          <p class="font-medium text-emerald-100">{formatIndonesianDate(new Date().toISOString())}</p>
        </div>
      </div>
    </div>

    <!-- Main Attendance Actions (React) -->
    <AttendancePortal client:only="react" userId={profile.id} initialTodayAttendance={todayAttendance} />

    <!-- Attendance History -->
    <div class="pt-8 space-y-3">
      <div class="flex justify-between items-center">
        <h3 class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Riwayat Kehadiran</h3>
        <span class="text-[10px] bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full font-bold">
          {totalItems} Sesi
        </span>
      </div>

      <div class="space-y-3">
        {(!history || history.length === 0) ? (
          <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto text-slate-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-xs font-bold">Belum Ada Riwayat</p>
            <p class="text-[10px] text-slate-400 mt-1 font-medium">Data kehadiran Anda akan muncul di sini setelah terekam.</p>
          </div>
        ) : (
          paginatedHistory.map((item: any) => (
            <div key={item.id} class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm hover:shadow-md transition-all flex justify-between items-center animate-fade-in">
              <div class="space-y-1">
                <p class="text-xs font-extrabold text-slate-700">
                  {formatIndonesianDate(item.sessions?.date || item.created_at)}
                </p>
                <div class="flex items-center gap-1.5">
                  <span class={`px-2 py-0.5 rounded text-[8px] font-bold uppercase border ${getStatusBadgeClass(item.status)}`}>
                    {item.status}
                  </span>
                  {(item.status === 'sakit' || item.status === 'izin') && (
                    <span class={`px-1.5 py-0.5 rounded text-[8px] font-black uppercase ${getApprovalBadgeClass(item.approval_status)}`}>
                      {item.approval_status === 'approved' ? 'Disetujui' : item.approval_status === 'pending' ? 'Pending' : 'Ditolak'}
                    </span>
                  )}
                </div>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-mono font-bold text-slate-400">
                  {new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}
                </span>
              </div>
            </div>
          ))
        )}
      </div>

      {/* Pagination Controls */}
      {totalPages > 1 && (
        <div class="flex justify-between items-center pt-5">
          <a
            href={page > 1 ? `?page=${page - 1}` : '#'}
            class={`px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-[10px] font-extrabold text-slate-600 transition-all active:scale-95 shadow-sm ${
              page === 1 ? 'opacity-40 pointer-events-none bg-slate-50' : 'hover:border-emerald-600 hover:text-emerald-800'
            }`}
          >
            &larr; Sebelumnya
          </a>
          
          <span class="text-[10px] text-slate-400 font-bold">
            Halaman {page} dari {totalPages}
          </span>
          
          <a
            href={page < totalPages ? `?page=${page + 1}` : '#'}
            class={`px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-[10px] font-extrabold text-slate-600 transition-all active:scale-95 shadow-sm ${
              page === totalPages ? 'opacity-40 pointer-events-none bg-slate-50' : 'hover:border-emerald-600 hover:text-emerald-800'
            }`}
          >
            Berikutnya &rarr;
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
