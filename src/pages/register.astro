return Astro.redirect('/login');
---

<Layout title="Daftar Akun">
  <div class="flex-grow flex flex-col justify-center py-6">
    <div class="bg-white/85 backdrop-blur-md p-8 rounded-3xl shadow-xl border border-slate-200/50 hover:shadow-2xl transition-all duration-300">
      <div class="text-center mb-8">
        <div class="inline-flex p-3 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white shadow-lg mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Daftar Akun</h2>
        <p class="text-xs text-slate-500 mt-1 font-medium">Buat akun untuk melakukan presensi</p>
      </div>

      {errorMsg && (
        <div class="mb-5 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          {errorMsg}
        </div>
      )}

      <form action="/api/register" method="POST" class="space-y-4">
        <div>
          <label for="fullName" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Nama Lengkap</label>
          <input
            type="text"
            name="fullName"
            id="fullName"
            required
            placeholder="Ahmad Suherman"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-medium"
          />
        </div>

        <div>
          <label for="nim" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">NIM</label>
          <input
            type="text"
            name="nim"
            id="nim"
            required
            placeholder="2201010043"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-medium"
          />
        </div>

        <div>
          <label for="prodi" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Program Studi (Prodi)</label>
          <input
            type="text"
            name="prodi"
            id="prodi"
            required
            placeholder="Informatika"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-medium"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="ahmad@unper.ac.id"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-medium"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Password</label>
          <input
            type="password"
            name="password"
            id="password"
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-medium"
          />
        </div>

        <div>
          <label for="role" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Peran (Role)</label>
          <select
            name="role"
            id="role"
            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none text-sm transition-all bg-slate-50 font-semibold text-slate-700"
          >
            <option value="member">Anggota (Mahasiswa)</option>
            <option value="admin">Sekretaris (Admin)</option>
          </select>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-700 hover:to-teal-600 text-white rounded-2xl text-sm font-bold shadow-md hover:shadow-lg hover:shadow-emerald-900/10 hover:-translate-y-0.5 active:translate-y-0 active:scale-98 transition-all"
        >
          Daftar
        </button>
      </form>

      <div class="mt-6 text-center">
        <p class="text-xs text-slate-500 font-medium">
          Sudah punya akun?{' '}
          <a href="/login" class="text-emerald-600 font-bold hover:underline">
            Masuk Disini
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
